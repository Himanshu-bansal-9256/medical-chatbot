{
  "name": "MediCare AI - Medical Chatbot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/app.py",
        "frontend/src/App.jsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "cd backend && pip3 install --user -r requirements.txt && cd ../frontend && npm install && echo '✅ All dependencies installed'",
  "postAttachCommand": {
    "backend": "cd backend && python app.py",
    "frontend": "cd frontend && npm run dev"
  },
  "portsAttributes": {
    "5000": {
      "label": "Backend API",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Frontend App",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    5000,
    5173
  ]
}